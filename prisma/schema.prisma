generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  avatar    String?
  email     String?
  isAdmin   Boolean  @default(false)
  /// R-2159: may change other people's grants (lib/accessAdmin.ts). The owner (ADMIN_DISCORD_ID) always may.
  isAccessAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  access    AppAccess[]
  appLinks  AppUserLink[]
}

model AppAccess {
  id        String   @id @default(cuid())
  userId    String
  appId     String
  granted   Boolean  @default(false)
  grantedAt DateTime @default(now())
  grantedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
}

model AppUserLink {
  id               String   @id @default(cuid())
  userId           String
  appId            String
  externalUserId   String
  externalUsername String?
  externalEmail    String?
  linkedBy         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
}

model PendingAppAccess {
  id             String   @id @default(cuid())
  email          String
  appId          String
  granted        Boolean  @default(true)
  grantedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  resolvedAt     DateTime?
  resolvedUserId String?

  @@unique([email, appId])
}

/// R-2159: a role preset = a named bundle of grant ids (lib/grants.ts). Presets only fill toggles; the stored truth
/// stays the per-person AppAccess rows, so editing a preset never changes anyone's access.
model AccessRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  grantIds    String[]
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// R-2159: one row per changed grant. Rows written together share changeId (one "change", revertable as a whole).
/// state values: "none" (no AppAccess row), "on" (granted true), "off" (granted false).
/// No foreign keys on purpose: the log outlives deleted users.
model AccessAudit {
  id            String   @id @default(cuid())
  changeId      String
  at            DateTime @default(now())
  actor         String
  actorName     String?
  targetUserId  String
  grantId       String
  oldState      String
  newState      String
  oldGrantedBy  String?
  oldGrantedAt  DateTime?
  note          String?
  revertOf      String?

  @@index([changeId])
  @@index([targetUserId, at])
  @@index([revertOf])
}

/// X6 (R-3258 B8, 28 Nov 2026): "Ask for access". One row per ask. state: "open", "approved", "declined".
/// openKey = "<userId>|<grantId>" while open, null once answered: the unique index keeps one open ask per person and
/// grant (Postgres allows many NULLs). Approve applies the grant through lib/accessChanges.ts setGrants (audited,
/// changeId = that change, Undo in History). No foreign keys on purpose, like AccessAudit.
model AccessRequest {
  id            String    @id @default(cuid())
  userId        String
  grantId       String
  reason        String?
  state         String    @default("open")
  openKey       String?   @unique
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?
  decidedBy     String?
  decidedByName String?
  decisionNote  String?
  changeId      String?

  @@index([state, createdAt])
  @@index([userId, grantId, createdAt])
}
